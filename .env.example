PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/tuktuk_world
JWT_SECRET=change_this_to_a_long_random_secret
CLIENT_URL=http://localhost:3000

# Development OTP. If Twilio is not configured, the OTP is returned on-screen.
SHOW_DEV_OTP=true

# Real SMS OTP via Twilio Verify (optional for local development)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Razorpay online payment (optional until online payments are enabled)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
